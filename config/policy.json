{
  "version": 1,
  "tiers": {
    "T0": {
      "approval": "none"
    },
    "T1": {
      "approval": "none",
      "dry_run_default": true,
      "rate_limit": "10/min"
    },
    "T2": {
      "approval": "out_of_band",
      "plan_ttl": "15m"
    }
  },
  "scopes": {
    "observe": {
      "tiers": [
        "T0"
      ]
    },
    "ops": {
      "tiers": [
        "T0",
        "T1"
      ]
    },
    "admin": {
      "tiers": [
        "T0",
        "T1",
        "T2"
      ]
    },
    "curator": {
      "tiers": [
        "T0",
        "T1",
        "T2"
      ],
      "only": [
        "photos_albums",
        "photos_album_profile",
        "photos_unsorted",
        "media_items",
        "memory_recall",
        "job_status"
      ]
    }
  },
  "toolsets": {
    "core": [
      "system_overview",
      "health_check",
      "storage_status",
      "service_status",
      "service_logs",
      "launchd_jobs",
      "tailscale_status",
      "media_staging_list",
      "photos_stats",
      "memory_recall",
      "runbook_get",
      "job_status"
    ]
  },
  "jobs": {
