{
  "host": {
    "name": "mini",
    "repo_root": "auto"
  },
  "storage": {
    "state_dir": "~/Library/Application Support/homelab",
    "log_root": "/Volumes/warmstore/logs",
    "launchd_log_dir": "/tmp",
    "tiers": {
      "faststore": {
        "mount": "/Volumes/faststore",
        "media": "nvme",
        "raid": "mirror",
        "warn_pct": 80,
        "crit_pct": 90,
        "use": "Photos (Immich), Plex and Jellyfin data"
      },
      "warmstore": {
        "mount": "/Volumes/warmstore",
        "media": "ssd",
        "raid": "mirror",
        "warn_pct": 85,
        "crit_pct": 95,
        "use": "Movies and TV, logs"
      },
      "coldstore": {
        "mount": "/Volumes/coldstore",
        "media": "hdd",
        "raid": "mirror",
        "warn_pct": 85,
        "crit_pct": 95,
        "use": "Cold archive"
      }
    }
  },
  "services": {
    "storage": {
      "kind": "job",
      "launchd": "io.homelab.storage",
      "ports": [],
      "depends_on": [],
      "optional": false
    },
    "powermgmt": {
      "kind": "job",
      "launchd": "io.homelab.powermgmt",
      "ports": [],
      "depends_on": [],
      "optional": false
    },
    "colima": {
      "kind": "runtime",
      "launchd": "io.homelab.colima",
      "ports": [],
      "health": {
        "expect": 200,
        "cmd": [
          "docker",
          "info"
        ]
      },
      "depends_on": [],
      "optional": false,
      "resources": {
        "cpu": 4,
        "memory_gb": 6,
        "disk_gb": 60
      }
    },
    "immich": {
      "kind": "compose",
      "launchd": "io.homelab.compose.immich",
      "ports": [
        2283
      ],
      "health": {
        "http": "http://localhost:2283/api/server/ping",
        "expect": 200
      },
      "depends_on": [
        "colima",
        "faststore"
      ],
      "compose_dir": "services/immich",
      "version_env": "IMMICH_VERSION",
      "optional": false,
      "api": {
        "base": "http://localhost:2283/api",
        "secret": "immich_api_key"
      }
    },
    "plex": {
      "kind": "native_app",
      "launchd": "io.homelab.plex",
      "ports": [
        32400
      ],
      "health": {
        "http": "http://localhost:32400/identity",
        "expect": 200
      },
      "depends_on": [
        "faststore",
        "warmstore"
      ],
      "app": "Plex Media Server",
      "optional": false,
      "data_tier": "faststore",
      "data_dir": "plex",
      "api": {
        "base": "http://localhost:32400",
        "secret": "plex_token"
      }
    },
    "jellyfin": {
      "kind": "native_app",
      "launchd": "io.homelab.jellyfin",
      "ports": [
        8096
      ],
      "health": {
        "http": "http://localhost:8096/health",
        "expect": 200
      },
      "depends_on": [
        "faststore",
        "warmstore"
      ],
      "app": "Jellyfin",
      "optional": false,
      "data_tier": "faststore",
      "data_dir": "jellyfin",
      "api": {
        "base": "http://localhost:8096",
        "secret": "jellyfin_api_key"
      }
    },
    "landing": {
      "kind": "process",
      "launchd": "io.homelab.landing",
      "ports": [
        8080
      ],
      "health": {
        "http": "http://127.0.0.1:8080/",
        "expect": 200
      },
      "depends_on": [],
      "optional": false
    },
    "media_watcher": {
      "kind": "process",
      "launchd": "io.homelab.media.watcher",
      "ports": [],
      "depends_on": [
        "warmstore"
      ],
      "optional": false
    },
    "tailscale": {
      "kind": "daemon",
      "launchd": "io.homelab.tailscale",
      "ports": [],
      "depends_on": [],
      "optional": true
    },
    "updatecheck": {
      "kind": "job",
      "launchd": "io.homelab.updatecheck",
      "ports": [],
      "depends_on": [],
      "optional": false
    },
    "mcp": {
      "kind": "process",
      "launchd": "io.homelab.mcp",
      "ports": [],
      "depends_on": [],
      "listen": "127.0.0.1:18765",
      "optional": false
    }
  },
  "boot_order": [
    "storage",
    "powermgmt",
    "colima",
    "immich",
    "plex",
    "jellyfin",
    "landing",
    "media_watcher",
    "tailscale",
    "updatecheck",
    "mcp"
  ],
  "remote_access": {
    "tailscale_serve": [
      {
        "https": 443,
        "target": "http://localhost:8080",
        "service": "landing"
      },
      {
        "https": 2283,
        "target": "http://localhost:2283",
        "service": "immich"
      },
      {
        "https": 32400,
        "target": "http://localhost:32400",
        "service": "plex"
      },
      {
        "https": 8096,
        "target": "http://localhost:8096",
        "service": "jellyfin"
      },
      {
        "https": 8765,
        "target": "http://127.0.0.1:18765",
        "service": "mcp"
      }
    ]
  },
  "media": {
    "tier": "warmstore",
    "staging": "staging",
    "failed": "staging/failed",
    "libraries": {
      "movies": {
        "dir": "movies",
        "staging": "movies"
      },
      "tv": {
        "dir": "tv-shows",
        "staging": "tv-shows"
      },
      "collections": {
        "dir": "collections",
        "staging": "collections"
      }
    }
  },
  "photos": {
    "tier": "faststore",
    "library": "immich",
    "takeout_downloads": "takeout-downloads",
    "takeout_work_dir": "tmp/takeout-processed"
  }
}
